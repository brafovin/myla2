# Kopiere diese Datei nach .env und passe die Werte an.

# Port des Servers
PORT=3000

# Geheimer Schluessel zum Signieren der Session-Tokens.
# In Produktion UNBEDINGT durch einen langen, zufaelligen Wert ersetzen!
AUTH_SECRET=bitte-aendern-langer-zufallswert

# Optionale TURN/STUN-Server fuer WebRTC (durch Komma getrennt).
# STUN reicht fuer viele Netze; fuer Verbindungen hinter striktem NAT
# wird ein TURN-Server benoetigt (z.B. eigener coturn oder Anbieter).
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:dein-turn-server:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
